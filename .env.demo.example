# ---------------------------------------------------------------------------
# PRIVATE DEMO — build configuration template
# ---------------------------------------------------------------------------
# Copy to `.env.demo` (git-ignored) and build with:
#
#   npm run build -- --mode demo
#
# This file is a TEMPLATE. It contains no credential and must never gain one.
# The private demo talks to nothing: no production database, no production lead
# endpoint, no production API token. Every server-side value in `.env.example`
# stays UNSET here — the lead form posts to an endpoint that is not configured,
# which is the intended behaviour for a content review build.
# ---------------------------------------------------------------------------

# Render the 18 draft articles so reviewers can read them.
# Drafts still ship noindex,nofollow,noarchive,nosnippet,noimageindex — that is
# a constant in src/data/blog/visibility.ts and this flag cannot override it.
VITE_BLOG_PREVIEW=true

# Search indexing stays off. Never set this to true for a demo.
VITE_ALLOW_INDEXING=false

# The demo's own origin, so canonical URLs point at the demo rather than at
# production. Replace with the actual demo hostname before building.
VITE_SITE_ORIGIN=https://demo.internal.example

# ---------------------------------------------------------------------------
# NOT SET ON PURPOSE — do not add these to a demo build
# ---------------------------------------------------------------------------
# LEAD_PROVIDER, HUBSPOT_ACCESS_TOKEN, LARK_WEBHOOK_URL, LARK_APP_ID,
# LARK_APP_SECRET, N8N_WEBHOOK_URL, LEAD_API_SHARED_SECRET, LEAD_ALLOWED_ORIGIN
#
# A demo that can write into the production CRM is not a demo. Leave the lead
# endpoint unconfigured; the form validates and fails closed.
# ---------------------------------------------------------------------------
