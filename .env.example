# GCALLS website — environment template
#
# Copy to `.env.local` for local development. Never commit real values.
#
# ---------------------------------------------------------------------------
# TWO KINDS OF VARIABLE — THE DISTINCTION MATTERS
# ---------------------------------------------------------------------------
# VITE_*  are PUBLIC. Vite inlines them into the JavaScript bundle, so every
#         visitor can read them. Only ever put non-secret values here.
#
# Everything else is SERVER-ONLY. It must be set in the hosting platform's
# environment (Vercel/Netlify/Cloudflare dashboard, or the server process) and
# must NEVER be prefixed with VITE_.
#
# Putting an API token in a VITE_ variable publishes it. There is no way to
# hide it afterwards — the token must be rotated.
# ---------------------------------------------------------------------------


# ===========================================================================
# PUBLIC — safe to ship to the browser
# ===========================================================================

# Canonical origin, used for canonical URLs and JSON-LD.
VITE_SITE_ORIGIN=https://gcalls.co

# Enables search indexing. Leave unset/false until go-live.
# See docs/LAUNCH_CHECKLIST.md.
VITE_ALLOW_INDEXING=false

# Lead endpoint URL. This is an ADDRESS, not a credential — safe to be public.
# Empty (the default) means no transport is configured: forms tell the visitor
# honestly that submission is unavailable rather than faking success.
# Same-origin example:  /api/leads
VITE_LEAD_API_URL=


# ===========================================================================
# SERVER-ONLY — never prefix these with VITE_
# ---------------------------------------------------------------------------
# Set these in the hosting platform, not in a file that reaches the client.
# Listed here as documentation of what a server implementation needs.
# ===========================================================================

# Which provider the endpoint delivers to: hubspot | lark | n8n
# LEAD_PROVIDER=

# HubSpot private app token
# HUBSPOT_ACCESS_TOKEN=

# Lark / Feishu webhook or app credentials
# LARK_WEBHOOK_URL=
# LARK_APP_ID=
# LARK_APP_SECRET=

# n8n webhook URL (treat as a secret: anyone with it can post leads)
# N8N_WEBHOOK_URL=

# Shared secret so only this site may post to the endpoint
# LEAD_API_SHARED_SECRET=

# Allowed browser origin for CORS. Never "*".
# LEAD_ALLOWED_ORIGIN=https://gcalls.co
